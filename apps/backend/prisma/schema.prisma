generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                             String   @id @default(uuid())
  email                          String   @unique
  name                           String
  passwordHash                   String
  
  decks                          Deck[]
  decksCompletionHistory         DeckCompletion[]

  aiGenerationsUsed              Int      @default(0)

  refreshToken                   String?
  
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
}

model Deck {
  id                        String   @id @default(uuid())
  title                     String
  
  userId                    String
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  isCompleted               Boolean  @default(false)
  completionHistory         DeckCompletion[]

  cards                     Card[]
  
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([userId])
}

model DeckCompletion {
  id                        String   @id @default(uuid())

  deckId                    String
  deck                      Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  
  userId                    String
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  completedAt               DateTime @default(now())
  completionDuration        Int
  correctAnswersCompleted   Int
  totalQuestions            Int

  @@index([userId, deckId, completedAt])
  @@index([deckId, completedAt])
}

model Card {
  id             String    @id @default(uuid())

  question       String
  answer         String
  options        String[]
  explanation    String

  nextReviewDate DateTime?
  
  deckId         String
  deck           Deck      @relation(fields: [deckId], references: [id], onDelete: Cascade)
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  @@index([deckId])
}